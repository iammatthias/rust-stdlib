      "rust": "rust_stdlib::unicode::rune::decode_last_rune"
    },
    "DecodeRune": {
      "rust": "rust_stdlib::unicode::rune::decode_rune"
    },
    "DecodeRuneInString": {
      "rust": "rust_stdlib::unicode::rune::decode_rune"
    },
    "EncodeRune": {
      "rust": "rust_stdlib::unicode::rune::encode_rune"
    },
    "FullRune": {
      "rust": "rust_stdlib::unicode::rune::full_rune"
    },
    "FullRuneInString": {
      "rust": "rust_stdlib::unicode::rune::full_rune"
    },
    "MaxRune": {
      "rust": "rust_stdlib::unicode::rune::MAX_RUNE"
    },
    "RuneCount": {
      "rust": "rust_stdlib::unicode::rune::rune_count"
