    },
    "Time.IsZero": {
      "rust": "rust_stdlib::time::Time::is_zero"
    },
    "Time.Local": {
      "rust": "rust_stdlib::time::Time::local"
    },
    "Time.Location": {
      "rust": "rust_stdlib::time::Time::location"
    },
    "Time.MarshalBinary": {
      "rust": "rust_stdlib::time::Time::marshal_binary"
    },
    "Time.MarshalJSON": {
      "rust": "rust_stdlib::time::Time::marshal_json"
    },
    "Time.MarshalText": {
      "rust": "rust_stdlib::time::Time::marshal_text"
    },
    "Time.Minute": {
      "rust": "rust_stdlib::time::Time::minute"
    },
    "Time.Month": {
      "rust": "rust_stdlib::time::Time::month"
    },
    "Time.Nanosecond": {
      "rust": "rust_stdlib::time::Time::nanosecond"
    },
    "Time.Round": {
      "rust": "rust_stdlib::time::Time::round"
    },
    "Time.Second": {
      "rust": "rust_stdlib::time::Time::second"
    },
    "Time.String": {
      "rust": "rust_stdlib::time::Time (impl Display)",
      "note": "to_string(); includes Go's m=±value monotonic suffix"
    },
    "Time.Sub": {
      "rust": "rust_stdlib::time::Time::sub"
    },
    "Time.Truncate": {
      "rust": "rust_stdlib::time::Time::truncate"
    },
    "Time.UTC": {
      "rust": "rust_stdlib::time::Time::utc"
    },
    "Time.Unix": {
      "rust": "rust_stdlib::time::Time::unix"
    },
    "Time.UnixMicro": {
      "rust": "rust_stdlib::time::Time::unix_micro"
    },
    "Time.UnixMilli": {
