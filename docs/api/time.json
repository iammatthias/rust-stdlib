    },
    "Time.Year": {
      "rust": "rust_stdlib::time::Time::year"
    },
    "Time.YearDay": {
      "rust": "rust_stdlib::time::Time::year_day"
    },
    "Time.Zone": {
      "rust": "rust_stdlib::time::Time::zone"
    },
    "Time.ZoneBounds": {
      "rust": "rust_stdlib::time::Time::zone_bounds"
    },
    "TimeOnly": {
      "rust": "rust_stdlib::time::TIME_ONLY"
    },
    "Timer": {
      "rust": "rust_stdlib::time::Timer"
    },
    "Timer.C": {
      "rust": "rust_stdlib::time::Timer::c",
      "note": "time::Channel (a Sync wrapper over a one-slot mpsc receiver with recv/try_recv/recv_timeout) instead of a Go channel; AfterFunc timers get a Channel that never yields, like Go's nil channel"
    },
    "Timer.Reset": {
      "rust": "rust_stdlib::time::Timer::reset",
      "note": "Go 1.23 semantics; Go's panic on a zero Timer cannot occur"
    },
    "Timer.Stop": {
      "rust": "rust_stdlib::time::Timer::stop",
      "note": "Go 1.23 semantics: discards a fired but unreceived value; Go's panic on a zero Timer cannot occur because Timer has no zero value"
    },
    "Tuesday": {
      "rust": "rust_stdlib::time::TUESDAY"
    },
    "UTC": {
      "rust": "rust_stdlib::time::Location::utc",
      "note": "Go's package variable is a function returning the shared UTC location"
    },
    "Unix": {
      "rust": "rust_stdlib::time::unix"
    },
    "UnixDate": {
